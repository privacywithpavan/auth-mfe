{
  "name": "auth-mfe-workspace",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --ui=tui",
    "dev:auth": "pnpm --filter @auth-mfe/app dev",
    "dev:idp": "pnpm --filter @auth-mfe/mock-idp dev",
    "dev:chat": "pnpm --filter @auth-mfe/chatbot-host dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "2.11.7"
  }
}
