{
  "name": "@auth-mfe/token-verifier",
  "version": "0.1.0",
  "private": true,
  "description": "Verify the domain-wide auth_token cookie (the IdP's session JWT) in a chatbot backend.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@auth-mfe/eslint-config": "workspace:*",
    "@auth-mfe/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^9",
    "tsdown": "0.23.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
