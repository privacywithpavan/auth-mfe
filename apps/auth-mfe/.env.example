# Copy to .env.local. Values below point at the local mock IdP (`pnpm dev` from the repo root starts it).

APP_ORIGIN=https://auth.localtest.me:3000

# In-house IdP API, called server-to-server by the BFF. Points at the mock for now.
IDP_BASE_URL=http://localhost:9000
# Expected "iss" of IdP-issued JWTs (defaults to IDP_BASE_URL)
# IDP_ISSUER=
# JWKS for verifying IdP-issued JWTs (defaults to IDP_BASE_URL/jwks)
# IDP_JWKS_URL=
IDP_CLIENT_ID=auth-mfe
IDP_CLIENT_SECRET=dev-client-secret

# Origins allowed to embed /login and /register (comma-separated, no trailing slash)
ALLOWED_PARENT_ORIGINS=https://chat.localtest.me:4000

# Org root domain for the auth_token cookie. This app and the chatbot must both live under it.
SESSION_COOKIE_DOMAIN=localtest.me
# Expected "aud" of the IdP's session JWT (the chatbot backend verifies the same value)
SESSION_TOKEN_AUDIENCE=chatbot

SESSION_TTL_SECONDS=28800
