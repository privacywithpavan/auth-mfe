# Copy to .env.local to override. The defaults below match the auth MFE's .env.example.

# MOCK_IDP_PORT=9000
# Client credentials the BFF must present (IDP_CLIENT_ID / IDP_CLIENT_SECRET in the auth MFE)
# MOCK_IDP_CLIENT_ID=auth-mfe
# MOCK_IDP_CLIENT_SECRET=dev-client-secret
# WebAuthn RP ID and the origin passkey ceremonies must come from: the auth MFE's host
# MOCK_IDP_RP_ID=auth.localtest.me
# MOCK_IDP_ORIGIN=https://auth.localtest.me:3000
# "false" lets password logins skip the second factor
# MOCK_IDP_REQUIRE_MFA=true
# aud and lifetime of the session JWT; lower the TTL to exercise refresh
# MOCK_IDP_SESSION_AUDIENCE=chatbot
# MOCK_IDP_SESSION_TTL_SECONDS=600
