# Copy to .env.local to override. The defaults below match `pnpm dev` with the mock IdP.

# Where this example chatbot is served, and where the auth MFE is.
# CHAT_ORIGIN=https://chat.localtest.me:4000
# AUTH_ORIGIN=https://auth.localtest.me:3000

# The IdP that signs auth_token. IDP_ISSUER and IDP_JWKS_URL default from IDP_BASE_URL.
# IDP_BASE_URL=http://localhost:9000
# IDP_ISSUER=
# IDP_JWKS_URL=

# The "aud" this chatbot accepts (the auth MFE's SESSION_TOKEN_AUDIENCE)
# SESSION_TOKEN_AUDIENCE=chatbot
